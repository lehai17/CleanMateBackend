@model IEnumerable<CleanMate.CleanerWeb.Models.BookingViewModel>

@{
    ViewData["Title"] = "My Bookings";
    Layout = "_Layout";
    // var bookings = ViewBag.Bookings as IEnumerable<dynamic>;
}

<div class="container mt-4">
    <h3 class="mb-4 text-center">Available and Assigned Bookings</h3>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info text-center">@TempData["Message"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">No available or assigned bookings.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped shadow-sm align-middle">
                <thead class="table-primary">
                    <tr class="text-center">
                        <th>Order Code</th>
                        <th>Customer</th>
                        <th>Start Time</th>
                        <th>Duration</th>
                        <th>Price (VND)</th>
                        <th>Address</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold">@b.OrderCode</td>
                            <td>@b.CustomerName</td>
                            <td>@b.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">@b.DurationHours h</td>
                            <td class="text-end">@b.Price.ToString("N0")</td>
                            <td>@b.Address</td>
                            <td>@b.PaymentMethod</td>
                            <td class="text-center">
                                @if (b.Status == "Accepted")
                                {
                                    <span class="badge bg-success">Accepted</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@b.Status</span>
                                }
                                @if (b.StartedAt.HasValue)
                                {
                                    <small class="d-block">Bắt đầu: @b.StartedAt.Value.ToUniversalTime().ToString("dd/MM/yyyy HH:mm") UTC</small>
                                }
                                @if (b.CompletedAt.HasValue)
                                {
                                    <small class="d-block">Hoàn thành: @b.CompletedAt.Value.ToUniversalTime().ToString("dd/MM/yyyy HH:mm") UTC</small>
                                }
                            </td>
                            <td class="text-center">
                                @if (b.Status is "Pending" or "Accepted" or "InProgress")
                                {
                                    var action = b.Status == "Pending" ? "Accept" : b.Status == "Accepted" ? "Start" : "Complete";
                                    var label = b.Status == "Pending" ? "Nhận đơn" : b.Status == "Accepted" ? "Bắt đầu công việc" : "Hoàn thành công việc";
                                    <form asp-action="@action" method="post">
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            @label
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
