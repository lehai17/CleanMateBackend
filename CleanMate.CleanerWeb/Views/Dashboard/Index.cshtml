@model CleanMate.CleanerWeb.Models.ApiUser
@{ ViewData["Title"] = "Cleaner Dashboard"; }
<div class="container mt-4">
    <h3>Cleaner Dashboard</h3>
    <dl class="row">
        <dt class="col-sm-4">Full Name</dt><dd class="col-sm-8">@Model.FullName</dd>
        <dt class="col-sm-4">City</dt><dd class="col-sm-8">@Model.CleanerProfile?.City</dd>
        <dt class="col-sm-4">Hourly Rate</dt><dd class="col-sm-8">@Model.CleanerProfile?.HourlyRate.ToString("N0") VND/hour</dd>
        <dt class="col-sm-4">Average Rating</dt><dd class="col-sm-8">@Model.CleanerProfile?.AvgRating.ToString("0.0")</dd>
        <dt class="col-sm-4">Bio</dt><dd class="col-sm-8">@Model.CleanerProfile?.Bio</dd>
        <dt class="col-sm-4">Address</dt><dd class="col-sm-8">@Model.CleanerProfile?.AddressText</dd>
    </dl>
    <a asp-controller="Booking" asp-action="List" class="btn btn-success">View Bookings</a>
</div>
